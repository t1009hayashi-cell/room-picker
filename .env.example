# 楽天アプリ管理画面の「アプリケーションID」
# GitHub Actions では Secrets に RAKUTEN_APPLICATION_ID として登録する。
# このファイルをコピーして .env を作り、そちらに実値を書くこと（.env は .gitignore 済み）。
RAKUTEN_APPLICATION_ID=

# 楽天アプリ管理画面の「アクセスキー」
# 2026年のAPI刷新で必須になった。片方だけでは 400 エラーで弾かれる。
RAKUTEN_ACCESS_KEY=

# アフィリエイトID（任意）。指定すると affiliateUrl が返る。
RAKUTEN_AFFILIATE_ID=

# --mock を付けずに実行するとき、1リクエストあたりの待機ミリ秒（既定 1100）
# 仕様書4.3: リクエスト間に1秒以上のsleepが必須
RAKUTEN_REQUEST_INTERVAL_MS=1100
