{
  "name": "room-assist",
  "version": "1.0.0",
  "private": true,
  "description": "楽天ROOM 投稿支援ツール — 日次抽出バッチ(GitHub Actions) + PWA(GitHub Pages)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fetch": "npm run build && node dist/src/index.js",
    "fetch:mock": "npm run build && node dist/src/index.js --mock",
    "test": "npm run build && node --test \"dist/test/*.test.js\" \"web-test/*.test.mjs\"",
    "test:node": "node --test \"dist/test/*.test.js\"",
    "test:web": "node --test \"web-test/*.test.mjs\"",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
